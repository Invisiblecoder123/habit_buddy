# ==============================================================================
# HABIT BUDDY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Client-Side Supabase Configuration (Safe to expose in frontend bundle with RLS)
# Replace with your actual Supabase Project URL and Anon Public Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Serverless Gemini API Configuration (SECURE / PRIVATE)
# This MUST be set in your Vercel Dashboard (Project Settings > Environment Variables)
# It is accessed ONLY on the server via /api/quote.js. NEVER prefix with VITE_.
GEMINI_API_KEY=your_gemini_api_key_here
